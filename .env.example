# Пример файла переменных окружения для продакшена
# Скопируйте этот файл в .env и заполните реальными значениями

# Секретный ключ Django (обязательно измените!)
# Сгенерировать новый можно командой: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-must-be-at-least-50-characters-long

# Режим отладки (False для продакшена)
DEBUG=False

# Разрешенные хосты (укажите ваш домен или IP)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1

# Настройка SSL редиректа (True если используется HTTPS)
SECURE_SSL_REDIRECT=True
